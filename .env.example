# Stripe Configuration (Payment Processing)
# Full guide: docs/STRIPE_SETUP.md
# Get your keys from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here

# Easyship (2024-09 API) — https://developers.easyship.com/
# Production: EASYSHIP_SANDBOX_MODE=false + prod_* token. Sandbox: true + sandbox token.
# If EASYSHIP_API_KEY is unset, checkout can still use zone fallback (USE_FALLBACK_RATES=true).
EASYSHIP_API_KEY=
EASYSHIP_SANDBOX_MODE=true
# Set to false (or remove) so /api/shipping/quote calls Easyship with Pirate Ship box parcels
USE_FALLBACK_RATES=false
# Ship-from address (state is TX in lib/constants/shipping.ts)
EASYSHIP_ORIGIN_ADDRESS_LINE1="1234 Your Street"
EASYSHIP_ORIGIN_CITY=Houston
EASYSHIP_ORIGIN_POSTAL_CODE=77001
EASYSHIP_ORIGIN_PHONE=
# Required on Easyship 2024-09 addresses (contact_email). Code falls back to orders@djcuisine.com if unset.
EASYSHIP_ORIGIN_EMAIL=

# App URL (for Stripe redirects and absolute product image URLs in Checkout)
# Development: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe webhooks — verify signatures on POST /api/webhooks/stripe
# Local: run `npm run stripe:listen` and paste the whsec_ shown in the terminal
# Production: Stripe Dashboard → Webhooks → endpoint signing secret
# Events to send: checkout.session.completed
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Database (Prisma) — required for webhook order persistence. SQLite for local dev.
# Run: npx prisma migrate dev
DATABASE_URL="file:./prisma/dev.db"

# Admin UI — password login at /admin (httpOnly cookie; set a long random token)
# ADMIN_PASSWORD=your-secure-password
# ADMIN_SESSION_TOKEN=generate-a-long-random-string

# Resend — transactional email when payment completes (webhook)
# RESEND_API_KEY=re_...
# ORDER_EMAIL_FROM="DJ Cuisine <orders@yourdomain.com>"
# ADMIN_EMAIL=you@yourdomain.com (for admin notifications when orders ship)
# ORDER_CONFIRMATION_EMAIL_TO_CUSTOMER=true

